ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('clipped_by_triangular_halfspace.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Regression fixture for the AABB-footprint approximation bug: the
   IfcPolygonalBoundedHalfSpace boundary here is a TRIANGLE, not its own
   AABB, so clipTrianglesByBoundedPlane must decline (not approximate) and
   the element must fall back to the safe OBB. The triangle's hypotenuse
   u+v=2 leaves the box's (2,2) corner outside the subtraction footprint, so
   the true DIFFERENCE would NOT cut that corner and max-z stays 3 — but the
   old AABB approximation (whose AABB is [-1,3]x[-1,3], covering the whole
   box) wrongly reported max-z=1.5, a 50% under-report. */
#1=IFCPROJECT('0proj',$,'P',$,$,$,$,(#20),#10);
#10=IFCUNITASSIGNMENT((#11));
#11=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCAXIS2PLACEMENT3D(#30,$,$);
#32=IFCLOCALPLACEMENT($,#31);
#40=IFCCARTESIANPOINT((0.,0.));
#41=IFCCARTESIANPOINT((2.,0.));
#42=IFCCARTESIANPOINT((2.,2.));
#43=IFCCARTESIANPOINT((0.,2.));
#44=IFCPOLYLINE((#40,#41,#42,#43,#40));
#45=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'Rect',#44);
#46=IFCCARTESIANPOINT((0.,0.,0.));
#47=IFCAXIS2PLACEMENT3D(#46,$,$);
#48=IFCDIRECTION((0.,0.,1.));
#49=IFCEXTRUDEDAREASOLID(#45,#47,#48,3.);
#50=IFCCARTESIANPOINT((0.,0.,1.5));
#51=IFCDIRECTION((0.,0.,1.));
#52=IFCDIRECTION((1.,0.,0.));
#53=IFCAXIS2PLACEMENT3D(#50,#51,#52);
#54=IFCPLANE(#53);
#55=IFCCARTESIANPOINT((0.,0.,0.));
#56=IFCAXIS2PLACEMENT3D(#55,$,$);
#57=IFCCARTESIANPOINT((-1.,-1.));
#58=IFCCARTESIANPOINT((3.,-1.));
#59=IFCCARTESIANPOINT((-1.,3.));
#61=IFCPOLYLINE((#57,#58,#59,#57));
#62=IFCPOLYGONALBOUNDEDHALFSPACE(#54,.F.,#56,#61);
#63=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#49,#62);
#64=IFCSHAPEREPRESENTATION(#20,'Body','Clipping',(#63));
#65=IFCPRODUCTDEFINITIONSHAPE($,$,(#64));
#70=IFCBUILDINGELEMENTPROXY('0clip',$,'ClippedBox',$,$,#32,#65,$);
ENDSEC;
END-ISO-10303-21;
