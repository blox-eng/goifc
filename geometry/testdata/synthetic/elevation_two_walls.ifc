ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('elevation_two_walls.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
/* wall A: 4.0 (X) long, 0.2 (Y) thick, 3.0 (Z) tall, centred on the origin.
   Its elevational face is the XZ plane, so it faces +/-Y. */
#10=IFCAXIS2PLACEMENT3D(#11,$,$);
#11=IFCCARTESIANPOINT((0.,0.,0.));
#12=IFCLOCALPLACEMENT($,#10);
#13=IFCAXIS2PLACEMENT2D(#14,$);
#14=IFCCARTESIANPOINT((0.,0.));
#15=IFCRECTANGLEPROFILEDEF(.AREA.,$,#13,4.,0.2);
#16=IFCAXIS2PLACEMENT3D(#17,$,$);
#17=IFCCARTESIANPOINT((0.,0.,0.));
#18=IFCDIRECTION((0.,0.,1.));
#19=IFCEXTRUDEDAREASOLID(#15,#16,#18,3.);
#20=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#19));
#21=IFCPRODUCTDEFINITIONSHAPE($,$,(#20));
#22=IFCWALL('0GUIDwallA000000000022',$,'A',$,$,#12,#21,$,$);
/* window in wall A: 1.0 (X) x 1.0 (Z) face, full 0.2 thickness, sill at z=1 */
#30=IFCAXIS2PLACEMENT3D(#31,$,$);
#31=IFCCARTESIANPOINT((0.,0.,1.));
#32=IFCLOCALPLACEMENT($,#30);
#33=IFCAXIS2PLACEMENT2D(#34,$);
#34=IFCCARTESIANPOINT((0.,0.));
#35=IFCRECTANGLEPROFILEDEF(.AREA.,$,#33,1.,0.2);
#36=IFCAXIS2PLACEMENT3D(#37,$,$);
#37=IFCCARTESIANPOINT((0.,0.,0.));
#38=IFCDIRECTION((0.,0.,1.));
#39=IFCEXTRUDEDAREASOLID(#35,#36,#38,1.);
#40=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#39));
#41=IFCPRODUCTDEFINITIONSHAPE($,$,(#40));
#42=IFCOPENINGELEMENT('0GUIDopenA000000000042',$,'Win',$,$,#32,#41,$,$);
#50=IFCRELVOIDSELEMENT('0GUIDrelA00000000000050',$,$,$,#22,#42);
/* wall B: identical, parallel, 5 m further along +Y and 1 m taller, so the two
   walls sit at different depths and are told apart by size as well as id */
#60=IFCAXIS2PLACEMENT3D(#61,$,$);
#61=IFCCARTESIANPOINT((0.,5.,0.));
#62=IFCLOCALPLACEMENT($,#60);
#63=IFCAXIS2PLACEMENT2D(#64,$);
#64=IFCCARTESIANPOINT((0.,0.));
#65=IFCRECTANGLEPROFILEDEF(.AREA.,$,#63,4.,0.2);
#66=IFCAXIS2PLACEMENT3D(#67,$,$);
#67=IFCCARTESIANPOINT((0.,0.,0.));
#68=IFCDIRECTION((0.,0.,1.));
#69=IFCEXTRUDEDAREASOLID(#65,#66,#68,4.);
#70=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#69));
#71=IFCPRODUCTDEFINITIONSHAPE($,$,(#70));
#72=IFCWALL('0GUIDwallB000000000072',$,'B',$,$,#62,#71,$,$);
ENDSEC;
END-ISO-10303-21;
