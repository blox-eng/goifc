ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('netarea_mm_overlap.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
/* MILLIMETRE file. Wall 4000 x 3000 mm face = 4 x 3 m -> gross 12 m^2. */
#11=IFCCARTESIANPOINT((0.,0.,0.));
#10=IFCAXIS2PLACEMENT3D(#11,$,$);
#12=IFCLOCALPLACEMENT($,#10);
#14=IFCCARTESIANPOINT((0.,0.));
#13=IFCAXIS2PLACEMENT2D(#14,$);
#15=IFCRECTANGLEPROFILEDEF(.AREA.,$,#13,4000.,3000.);
#17=IFCCARTESIANPOINT((0.,0.,0.));
#16=IFCAXIS2PLACEMENT3D(#17,$,$);
#18=IFCDIRECTION((0.,0.,1.));
#19=IFCEXTRUDEDAREASOLID(#15,#16,#18,200.);
#20=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#19));
#21=IFCPRODUCTDEFINITIONSHAPE($,$,(#20));
#22=IFCWALL('0GUIDwall0000000000022',$,'W',$,$,#12,#21,$,$);
/* window A: 1000 x 1000 mm at origin */
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCAXIS2PLACEMENT3D(#30,$,$);
#32=IFCLOCALPLACEMENT($,#31);
#33=IFCCARTESIANPOINT((0.,0.));
#34=IFCAXIS2PLACEMENT2D(#33,$);
#35=IFCRECTANGLEPROFILEDEF(.AREA.,$,#34,1000.,1000.);
#36=IFCCARTESIANPOINT((0.,0.,0.));
#37=IFCAXIS2PLACEMENT3D(#36,$,$);
#38=IFCDIRECTION((0.,0.,1.));
#39=IFCEXTRUDEDAREASOLID(#35,#37,#38,200.);
#40=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#39));
#41=IFCPRODUCTDEFINITIONSHAPE($,$,(#40));
#42=IFCOPENINGELEMENT('0GUIDopen0000000000042',$,'WinA',$,$,#32,#41,$,$);
/* window B: 1000 x 1000 mm translated (300,300,0) mm = 0.3 m -> overlaps A in metres.
   If the placement translation is NOT meter-scaled it lands at ~300 m and the
   overlap is silently missed (host wrongly trusted). Correct code -> untrusted. */
#60=IFCCARTESIANPOINT((300.,300.,0.));
#61=IFCAXIS2PLACEMENT3D(#60,$,$);
#62=IFCLOCALPLACEMENT($,#61);
#63=IFCCARTESIANPOINT((0.,0.));
#64=IFCAXIS2PLACEMENT2D(#63,$);
#65=IFCRECTANGLEPROFILEDEF(.AREA.,$,#64,1000.,1000.);
#66=IFCCARTESIANPOINT((0.,0.,0.));
#67=IFCAXIS2PLACEMENT3D(#66,$,$);
#68=IFCDIRECTION((0.,0.,1.));
#69=IFCEXTRUDEDAREASOLID(#65,#67,#68,200.);
#70=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#69));
#71=IFCPRODUCTDEFINITIONSHAPE($,$,(#70));
#72=IFCOPENINGELEMENT('0GUIDopen0000000000072',$,'WinB',$,$,#62,#71,$,$);
#50=IFCRELVOIDSELEMENT('0GUIDrel00000000000050',$,$,$,#22,#42);
#51=IFCRELVOIDSELEMENT('0GUIDrel00000000000051',$,$,$,#22,#72);
ENDSEC;
END-ISO-10303-21;
