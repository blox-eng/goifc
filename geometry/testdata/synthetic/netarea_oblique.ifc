ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('netarea_oblique.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
/* wall running along Y: 0.2 thick (X) x 4.0 long (Y) x 3.0 tall (Z).
   Elevational face normal is +X -> winning axis 0 (YZ plane), NOT the axis 2
   the axis-aligned fixtures win on: proves the winning axis is computed and
   reused per host rather than assumed. Gross = 4x3 = 12. */
#11=IFCCARTESIANPOINT((0.,0.,0.));
#10=IFCAXIS2PLACEMENT3D(#11,$,$);
#12=IFCLOCALPLACEMENT($,#10);
#14=IFCCARTESIANPOINT((0.,0.));
#13=IFCAXIS2PLACEMENT2D(#14,$);
#15=IFCRECTANGLEPROFILEDEF(.AREA.,$,#13,0.2,4.);
#17=IFCCARTESIANPOINT((0.,0.,0.));
#16=IFCAXIS2PLACEMENT3D(#17,$,$);
#18=IFCDIRECTION((0.,0.,1.));
#19=IFCEXTRUDEDAREASOLID(#15,#16,#18,3.);
#20=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#19));
#21=IFCPRODUCTDEFINITIONSHAPE($,$,(#20));
#22=IFCWALL('0GUIDwall0000000000022',$,'W',$,$,#12,#21,$,$);
/* window: 0.2 (X) x 1.0 (Y) x 1.0 (Z), placed at (0,0,1) -> Y[-0.5,0.5] Z[1,2] */
#30=IFCCARTESIANPOINT((0.,0.,1.));
#31=IFCAXIS2PLACEMENT3D(#30,$,$);
#32=IFCLOCALPLACEMENT($,#31);
#33=IFCCARTESIANPOINT((0.,0.));
#34=IFCAXIS2PLACEMENT2D(#33,$);
#35=IFCRECTANGLEPROFILEDEF(.AREA.,$,#34,0.2,1.);
#37=IFCCARTESIANPOINT((0.,0.,0.));
#36=IFCAXIS2PLACEMENT3D(#37,$,$);
#38=IFCDIRECTION((0.,0.,1.));
#39=IFCEXTRUDEDAREASOLID(#35,#36,#38,1.);
#40=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#39));
#41=IFCPRODUCTDEFINITIONSHAPE($,$,(#40));
#42=IFCOPENINGELEMENT('0GUIDopen0000000000042',$,'Win',$,$,#32,#41,$,$);
#50=IFCRELVOIDSELEMENT('0GUIDrel00000000000050',$,$,$,#22,#42);
ENDSEC;
END-ISO-10303-21;
