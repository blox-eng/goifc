ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('netarea_arch_window.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
/* wall: 4.0 (X) x 3.0 (Y) elevational face, 0.2 thick (Z) */
#11=IFCCARTESIANPOINT((0.,0.,0.));
#10=IFCAXIS2PLACEMENT3D(#11,$,$);
#12=IFCLOCALPLACEMENT($,#10);
#14=IFCCARTESIANPOINT((0.,0.));
#13=IFCAXIS2PLACEMENT2D(#14,$);
#15=IFCRECTANGLEPROFILEDEF(.AREA.,$,#13,4.,3.);
#17=IFCCARTESIANPOINT((0.,0.,0.));
#16=IFCAXIS2PLACEMENT3D(#17,$,$);
#18=IFCDIRECTION((0.,0.,1.));
#19=IFCEXTRUDEDAREASOLID(#15,#16,#18,0.2);
#20=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#19));
#21=IFCPRODUCTDEFINITIONSHAPE($,$,(#20));
#22=IFCWALL('0GUIDwall0000000000022',$,'W',$,$,#12,#21,$,$);
/* arched opening: pentagon boundary, bounding box 1.0 (X) x 1.0 (Y), 0.2 thick */
#30=IFCCARTESIANPOINT((0.,0.,0.));
#31=IFCAXIS2PLACEMENT3D(#30,$,$);
#32=IFCLOCALPLACEMENT($,#31);
#33=IFCCARTESIANPOINT((-0.5,-0.5));
#34=IFCCARTESIANPOINT((0.5,-0.5));
#35=IFCCARTESIANPOINT((0.5,0.2));
#36=IFCCARTESIANPOINT((0.,0.5));
#37=IFCCARTESIANPOINT((-0.5,0.2));
#38=IFCPOLYLINE((#33,#34,#35,#36,#37,#33));
#39=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#38);
#43=IFCCARTESIANPOINT((0.,0.,0.));
#44=IFCAXIS2PLACEMENT3D(#43,$,$);
#45=IFCDIRECTION((0.,0.,1.));
#46=IFCEXTRUDEDAREASOLID(#39,#44,#45,0.2);
#47=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#46));
#48=IFCPRODUCTDEFINITIONSHAPE($,$,(#47));
#49=IFCOPENINGELEMENT('0GUIDopen0000000000049',$,'Arch',$,$,#32,#48,$,$);
#50=IFCRELVOIDSELEMENT('0GUIDrel00000000000050',$,$,$,#22,#49);
ENDSEC;
END-ISO-10303-21;
