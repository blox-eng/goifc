ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('two_storey_spanning.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));

/* spatial tree: Project -> Site -> Building -> (Ground Floor, Level 1) */
#5=IFCPROJECT('0GUIDproject00000000005',$,'Proj',$,$,$,$,$,#2);
#6=IFCSITE('0GUIDsite00000000000006',$,'Site A',$,$,$,$,$,.ELEMENT.,$,$,$,$,$);
#7=IFCBUILDING('0GUIDbuilding0000000007',$,'Building A',$,$,$,$,$,.ELEMENT.,$,$,$);
#8=IFCBUILDINGSTOREY('0GUIDstoreyground000008',$,'Ground Floor',$,$,$,$,$,.ELEMENT.,0.);
#9=IFCBUILDINGSTOREY('0GUIDstoreylevel1000009',$,'Level 1',$,$,$,$,$,.ELEMENT.,3.);
#20=IFCRELAGGREGATES('0GUIDra0000000000000020',$,$,$,#5,(#6));
#21=IFCRELAGGREGATES('0GUIDra0000000000000021',$,$,$,#6,(#7));
#22=IFCRELAGGREGATES('0GUIDra0000000000000022',$,$,$,#7,(#8,#9));

/* Column: world (5,5,0), 0.4 x 0.4 profile, extruded +Z 6.0 -> box Z [0,6] */
#100=IFCCARTESIANPOINT((5.,5.,0.));
#101=IFCAXIS2PLACEMENT3D(#100,$,$);
#102=IFCLOCALPLACEMENT($,#101);
#103=IFCCARTESIANPOINT((0.,0.));
#104=IFCAXIS2PLACEMENT2D(#103,$);
#105=IFCRECTANGLEPROFILEDEF(.AREA.,$,#104,0.4,0.4);
#106=IFCCARTESIANPOINT((0.,0.,0.));
#107=IFCAXIS2PLACEMENT3D(#106,$,$);
#108=IFCDIRECTION((0.,0.,1.));
#109=IFCEXTRUDEDAREASOLID(#105,#107,#108,6.);
#110=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#109));
#111=IFCPRODUCTDEFINITIONSHAPE($,$,(#110));
#112=IFCCOLUMN('0GUIDcolumn00000000112',$,'C-1',$,$,#102,#111,$,$);

/* Wall: world (0,0,0), 3.0 x 0.3 profile, extruded +Z 2.5 -> box Z [0,2.5] */
#120=IFCCARTESIANPOINT((0.,0.,0.));
#121=IFCAXIS2PLACEMENT3D(#120,$,$);
#122=IFCLOCALPLACEMENT($,#121);
#123=IFCCARTESIANPOINT((0.,0.));
#124=IFCAXIS2PLACEMENT2D(#123,$);
#125=IFCRECTANGLEPROFILEDEF(.AREA.,$,#124,3.,0.3);
#126=IFCCARTESIANPOINT((0.,0.,0.));
#127=IFCAXIS2PLACEMENT3D(#126,$,$);
#128=IFCDIRECTION((0.,0.,1.));
#129=IFCEXTRUDEDAREASOLID(#125,#127,#128,2.5);
#130=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#129));
#131=IFCPRODUCTDEFINITIONSHAPE($,$,(#130));
#132=IFCWALL('0GUIDwall000000000132',$,'W-1',$,$,#122,#131,$,$);

/* Slab: world (2,2,2.8), 4.0 x 4.0 profile, extruded +Z 0.2 -> box Z [2.8,3.0] */
#140=IFCCARTESIANPOINT((2.,2.,2.8));
#141=IFCAXIS2PLACEMENT3D(#140,$,$);
#142=IFCLOCALPLACEMENT($,#141);
#143=IFCCARTESIANPOINT((0.,0.));
#144=IFCAXIS2PLACEMENT2D(#143,$);
#145=IFCRECTANGLEPROFILEDEF(.AREA.,$,#144,4.,4.);
#146=IFCCARTESIANPOINT((0.,0.,0.));
#147=IFCAXIS2PLACEMENT3D(#146,$,$);
#148=IFCDIRECTION((0.,0.,1.));
#149=IFCEXTRUDEDAREASOLID(#145,#147,#148,0.2);
#150=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#149));
#151=IFCPRODUCTDEFINITIONSHAPE($,$,(#150));
#152=IFCSLAB('0GUIDslab000000000152',$,'S-1',$,$,#142,#151,$,$);

/* containment: Ground Floor <- (Column, Wall); Level 1 <- (Slab) */
#160=IFCRELCONTAINEDINSPATIALSTRUCTURE('0GUIDrc0000000000000160',$,$,$,(#112,#132),#8);
#161=IFCRELCONTAINEDINSPATIALSTRUCTURE('0GUIDrc0000000000000161',$,$,$,(#152),#9);
ENDSEC;
END-ISO-10303-21;
