ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('wall_mm_placed','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCUNITASSIGNMENT((#1));

/* wall placed at (5000,0,3000) mm = (5.0,0.0,3.0) m */
#10=IFCCARTESIANPOINT((5000.,0.,3000.));
#11=IFCAXIS2PLACEMENT3D(#10,$,$);
#12=IFCLOCALPLACEMENT($,#11);

#20=IFCWALL('0GUIDwallmm000000000020',$,'W-MM',$,$,#12,$,$,$);
ENDSEC;
END-ISO-10303-21;
