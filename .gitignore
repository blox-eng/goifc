# Coverage profile written by `make test` and by the Test job in ci.yml.
coverage.out
coverage.html

# Rendered docs site from `mkdocs build`. The published copy lives on the
# gh-pages branch, written by mike from the Docs workflow — never committed here.
/site/

# Python venv holding the pinned docs toolchain, created by `make docs-deps`.
/.venv-docs/

# Agent scratch space. Tracked here rather than in .git/info/exclude, which is
# per-clone and so silently stops working for everyone else.
.superpowers/

# Scratch changelog fed to the goreleaser hook by the release workflow's
# go-semantic-release/action step. Never the real CHANGELOG.md — that's
# promoted by hand in a separate workflow step.
/.release-notes.md
